# Copiare in .env e sostituire i valori con quelli della propria macchina.
# Base URL compatibile OpenAI di LM Studio, /v1 compreso.
LM_BASE_URL=http://localhost:1234/v1
# ID restituito da GET /v1/models (mai inventato).
LM_MODEL=<ID restituito da GET /v1/models>
# Fuso IANA usato quando l'utente non ne indica uno.
TZ_PREDEFINITO=Europe/Rome
# Facoltativo: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
# Lezione 5 — variante con cui l'agente raggiunge l'orologio: locale, fastapi oppure mcp (predefinita).
# calcola e converti arrivano sempre dal server MCP.
VARIANTE_OROLOGIO=mcp
# Solo per VARIANTE_OROLOGIO=fastapi: indirizzo del servizio avviato con uvicorn.
OROLOGIO_API_URL=http://localhost:8000
