# Copiare in .env e sostituire i valori con quelli della propria macchina.
# Base URL compatibile OpenAI di LM Studio, /v1 compreso.
LM_BASE_URL=http://localhost:1234/v1
# ID restituito da GET /v1/models (mai inventato).
LM_MODEL=<ID restituito da GET /v1/models>
# Fuso IANA usato quando l'utente non ne indica uno.
TZ_PREDEFINITO=Europe/Rome
# Facoltativo: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
# Lezione 5 — variante con cui l'agente raggiunge l'orologio: locale, fastapi oppure mcp (predefinita).
# calcola e converti arrivano sempre dal server MCP.
VARIANTE_OROLOGIO=mcp
# Solo per VARIANTE_OROLOGIO=fastapi: indirizzo del servizio avviato con uvicorn.
OROLOGIO_API_URL=http://localhost:8000
# Lezione 6 — tutte facoltative: senza, valgono i valori predefiniti indicati.
# Di che cosa si occupa l'agente: il router rifiuta le domande che non c'entrano (predefinito: vedi config.py).
# AMBITO_AGENTE=Data e ora nei fusi orari, calcoli aritmetici, conversioni di unità di misura.
# Quante volte il revisore può rimandare indietro una risposta (0 = revisore spento).
LIMITE_REVISIONI=2
# Oltre questo numero di messaggi la cronologia viene riassunta (0 = riassunto spento).
SOGLIA_RIASSUNTO=12
# Quanti messaggi recenti restano intatti dopo il riassunto (almeno 2, meno della soglia).
MESSAGGI_DA_CONSERVARE=6
# Step 4 — facoltativa: file delle preferenze letto dalla resource utente://preferenze
# (predefinito: preferenze.json nella cartella del progetto).
# PREFERENZE_FILE=C:\percorso\preferenze-prova.json
# Step 6 — usate dalla CLI (python -m assistente), che è un client del servizio dell'agente.
# Indirizzo del servizio avviato con uvicorn (o con docker compose).
AGENTE_URL=http://localhost:8001
# Secondi di attesa massima per una risposta: le spiegazioni lunghe possono durare minuti.
AGENTE_TIMEOUT=600
# Step 7 — PostgreSQL del laboratorio e back-end. Scegliere una password propria: il file .env resta fuori da Git.
POSTGRES_USER=chat
POSTGRES_PASSWORD=<una password a scelta>
POSTGRES_DB=chat
# Indirizzo usato dal back-end avviato in locale: stesse credenziali, porta 5434 pubblicata da docker compose.
DATABASE_URL=postgresql+psycopg://chat:<la stessa password>@localhost:5434/chat
# Step 8 — da quali indirizzi una pagina web può chiamare il back-end (separati da virgole).
# In locale la pagina è servita sulla porta 8003. Con il proxy dello step 9 non serve.
CORS_ORIGINI=http://localhost:8003
# Step 9 — porta del computer su cui il browser trova l'applicazione avviata con docker compose (predefinita 8085).
# PORTA_WEB=8085
